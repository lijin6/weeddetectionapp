<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- 按钮背景颜色 -->
    <solid android:color="#FFFFFF"/>

    <!-- 按钮边框 (可选) -->
    <stroke
        android:width="2dp"
        android:color="#CCCCCC"/>

    <!-- 阴影或内边距 (可选) -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp"/>

</shape>
